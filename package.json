{
  "name": "copilote-projet-ia",
  "version": "1.0.0",
  "description": "La méthode pour travailler avec l'IA quand on est chef de projet.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --check \"src/**/*.{ts,css,html,json}\"",
    "format:write": "prettier --write \"src/**/*.{ts,css,html,json}\"",
    "validate:workflows": "node scripts/validate-workflows.cjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0"
  }
}
